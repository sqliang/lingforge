# Production configuration (copy to .env.production and fill in real values)

# Public root domain; Caddy serves app./api./preview. subdomains from it
BASE_DOMAIN=example.com

# Supabase (use the SAME project as local dev, or a dedicated production project)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
# Product state stays in the compose db container; point to Supabase Postgres
# here only if you prefer managed data (then remove the local override in compose).
DATABASE_URL=postgresql://postgres:postgres@db:5432/postgres

# Model used by Deep Agents
MODEL_BASE_URL=https://api.deepseek.com
MODEL_API_KEY=
MODEL_NAME=deepseek-v4-pro

# Platform origins (derived from BASE_DOMAIN)
PLATFORM_ORIGIN=https://app.example.com
API_ORIGIN=https://api.example.com
PREVIEW_ORIGIN=https://preview.example.com
# Tighten CORS to PLATFORM_ORIGIN in production
CORS_PERMISSIVE=false

PROJECTS_ROOT=/var/lib/lite-atoms/projects
ARTIFACTS_ROOT=/var/lib/lite-atoms/artifacts
BUILD_RUNNER_IMAGE=lite-atoms-build-runner:local
PREVIEW_TICKET_SECRET=<generate-a-long-random-secret>

# Browser configuration (baked into the frontend build)
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-key>
VITE_API_BASE_URL=https://api.example.com

# Optional observability
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=lite-atoms-dev
